# Core radar works without an external model or credentials.
# Optional model-based classification and video generation:
OPENROUTER_API_KEY=
# Optional compatible gateway for the video tools:
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Optional override for the radar settings file:
# XRADAR_CONFIG=./config.json
# Video models are provider-dependent; choose IDs available to your account.
# XRADAR_IMAGE_MODEL=
# XRADAR_TRANSCRIBE_MODEL=
# XRADAR_TTS_MODEL_ELEVEN=
# REMOTION_BROWSER=
